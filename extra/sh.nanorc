## Syntax highlighting for Bourne shell scripts.

## Original author:  Mike Frysinger
## Modified by Mikhail Shprygov

syntax sh "(\.sh|(^|/|\.)(a|ba|c|da|k|mk|pdk|tc|z)sh(rc|_profile)?|(/etc/|(^|/)\.)profile)$"
header "^#!.*/(((env|busybox)[[:blank:]]+)?(a|ba|c|da|k|mk|pdk|tc|z)?sh|openrc-run|runscript)\>"
header "-\*-.*shell-script.*-\*-"
magic "(POSIX|Bourne-Again) shell script.*text"
comment "#"

linter dash -n

# Function declarations.
#color brightgreen "^[A-Za-z0-9_-]+\(\)"

# Keywords, symbols, and comparisons.
color lightblue "\<(break|case|continue|do|done|elif|else|esac|exit|fi|for|function|if|in|read|return|select|shift|then|time|until|while|sleep)\>"
color magenta "\<(return|exit|break|continue)\>"
color green "\<(kill|pkill|killall)\>"
color green "\<(declare|eval|exec|export|let|local)\>"
color green "[][{}():;,|`$<>~!=\\&]"
color green "([+-/*%]|>>|<<|&|\^|\|)="
#color yellow "[)(]"
#color yellow "[][{}()$`'\"]"
color green "-(eq|ne|gt|lt|ge|le|ef|ot|nt)\>"

# Numbers
icolor brightred "\<[0-9]+((\.[0-9]+)|(llu|ull|ul|lu|ll|l|u))?\>"
icolor brightred "\<[0-9]+\.?[0-9]*[e][+-]?[0-9]+[f]?\>"
icolor brightred "\<0[x][0-9a-f]+(llu|ull|ul|lu|ll|l|u)?\>"
icolor brightred "\<0[0-7]+(llu|ull|ul|lu|ll|l|u)?\>"
icolor brightred "\<0[b][0-1]+(llu|ull|ul|lu|ll|l|u)?\>"

# Short and long options.
color green "[[:blank:]](-[A-Za-z]|--\<[A-Za-z-]+)\>"

# Common commands.
color green "\<(awk|cat|cd|ch(grp|mod|own)|cp|cut|echo|env|grep|head|install|ln|make|mkdir|mv|popd|printf|pushd|rm|rmdir|sed|set|sort|tail|tar|touch|umask|unset|read|ls|wc|pwd|which|whereis|uname|find|xargs|tee|tr|source|du|df|date|su(do)?)|curl|wget|ping|ssh|rsync|scp\>"
color normal "[.-]tar\>"

# Strings.
color brightyellow ""([^"\]|\\.)*"|'([^'\]|\\.)*'"

# Basic variable names (no braces).
color brightgreen "\$([-@*#?$!0-9]|[[:alpha:]_][[:alnum:]_]*)"
# More complicated variable names; handles braces and replacements and arrays.
color brightgreen "\$\{[#!]?([-@*#?$!]|[0-9]+|[[:alpha:]_][[:alnum:]_]*)(\[([[:blank:]]*[[:alnum:]_]+[[:blank:]]*|@)\])?(([#%/]|:?[-=?+])[^}]*\}|\[|\})"
# Fix $ inside strings
color brightgreen "[$]"
color brightgreen "\<$_\>"

# Trailing whitespace.
color ,green "[[:space:]]+$"

# Comments.
color cyan "(^|[[:blank:]])#.*"
