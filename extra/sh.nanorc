## Syntax highlighting for Bourne shell scripts.

## Original author:  Mike Frysinger
## Modified by Mikhail Shprygov

syntax sh "(\.sh|(^|/|\.)(a|ba|c|da|k|mk|pdk|tc|z)sh(rc|_profile)?|(/etc/|(^|/)\.)profile)$"
header "^#!.*/(((env|busybox)[[:blank:]]+)?(a|ba|c|da|k|mk|pdk|tc|z)?sh|openrc-run|runscript)\>"
header "-\*-.*shell-script.*-\*-"
magic "(POSIX|Bourne-Again) shell script.*text"
comment "#"

linter dash -n

# Function declarations.
#color brightgreen "^[A-Za-z0-9_-]+\(\)"

# Keywords, symbols, and comparisons.
color brightblue "(^|[[:blank:]]|;|\||&|\{)(break|case|continue|do|done|elif|else|esac|exit|fi|for|function|if|in|read|return|select|shift|then|time|until|while|sleep)([[:blank:]]|;|\||&|\}|\\|$)"
color brightblue "(^|[[:blank:]]|;|\||&|\{)(declare|eval|exec|extract|export|source|let|local|test)([[:blank:]]|;|\||&|\}|\\|$)"
color brightblue "(^|[[:blank:]]|;|\||&|\{)(kill|pkill|killall)([[:blank:]]|;|\||&|\}|\\|$)"
color magenta "(^|[[:blank:]]|;|\||&|\{)(return|exit|break|continue)([[:blank:]]|;|\||&|\}|\\|$)"
color green "[][{}():;,|`$<>!=\\&]"
color green "([+-/*%]|>>|<<|&|\^|\|)="
color green "=(~)"
#color yellow "[)(]"
#color yellow "[][{}()$`'\"]"
color green "-(eq|ne|gt|lt|ge|le|ef|ot|nt)\>"

# Numbers
icolor cyan "\<[0-9]+((\.[0-9]+)|(llu|ull|ul|lu|ll|l|u))?\>"
icolor cyan "\<[0-9]+\.?[0-9]*[e][+-]?[0-9]+[f]?\>"
icolor cyan "\<0[x][0-9a-f]+(llu|ull|ul|lu|ll|l|u)?\>"
icolor cyan "\<0[0-7]+(llu|ull|ul|lu|ll|l|u)?\>"
icolor cyan "\<0[b][0-1]+(llu|ull|ul|lu|ll|l|u)?\>"

# Short and long options.
color green "[[:blank:]](-[A-Za-z]+|--\<[A-Za-z-]+)\>"

# Common commands.
color brightgreen "(^|[[:blank:]]|;|\||&|\{)(awk|cat|tac|cd|ch(grp|mod|own)|cp|cut|echo|env|grep|head|install|ln|make|mkdir|mv|popd|printf|pushd|rm|rmdir|sed|set|sort|tail|tar|touch|umask|unset|read|ls|wc|pwd|which|whereis|uname|find|xargs|tee|tr|du|df|date|su(do)?|curl|wget|ping|ssh|rsync|scp)([[:blank:]]|;|\||&|\}|\\|$)"
color normal "[.-]tar\>"

# Strings.
color brightgreen ""([^"\]|\\.)*"|'([^'\]|\\.)*'"

# Basic variable names (no braces).
color brightyellow "\$([-@*#?$!0-9]|[[:alpha:]_][[:alnum:]_]*)"
# More complicated variable names; handles braces and replacements and arrays.
color brightyellow "\$\{[#!]?([-@*#?$!]|[0-9]+|[[:alpha:]_][[:alnum:]_]*)(\[([[:blank:]]*[[:alnum:]_]+[[:blank:]]*|@)\])?(([#%/]|:?[-=?+])[^}]*\}|\[|\})"
# Fix $ inside strings
color brightyellow "[$]"
color brightyellow "\<$_\>"

# Trailing whitespace.
color ,green "[[:space:]]+$"

# Comments.
color red "(^|[[:blank:]])#.*"

# Git conflict markers
color black,red "^[[:blank:]]*(<<<<<<<|=======|>>>>>>>).*$"
