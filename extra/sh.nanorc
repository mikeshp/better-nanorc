## Syntax highlighting for Bourne shell scripts.

## Original author:  Mike Frysinger
## Modified by Mikhail Shprygov

syntax sh "(\.sh|(^|/|\.)(a|ba|c|da|k|mk|pdk|tc|z)sh(rc|_profile|_aliases)?|(/etc/|(^|/)\.)profile)$"
header "^#!.*/(((env|busybox)[[:blank:]]+)?(a|ba|c|da|k|mk|pdk|tc|z)?sh|openrc-run|runscript)\>"
header "-\*-.*shell-script.*-\*-"
magic "(POSIX|Bourne-Again) shell script.*text"
comment "#"

linter dash -n

# Function declarations.
#color brightgreen "^[A-Za-z0-9_-]+\(\)"

# Keywords, symbols, and comparisons.
color brightyellow "\<(break|case|continue|do|done|elif|else|esac|exit|fi|for|function|if|in|read|return|select|shift|then|time|until|while|sleep|coproc|wait)\>"
color brightyellow "\<(declare|eval|exec|export|source|let|local|test|typeset|readonly)\>"
color brightred "\<(kill|pkill|killall)\>"
color brightred "\<(return|exit|break|continue|logout)\>"

# Short and long options.
color green "[[:blank:]](-[A-Za-z]+|--\<[A-Za-z-]+)\>"

# Common commands.
color green "\<(awk|cat|tac|cd|ch(grp|mod|own)|cp|cut|echo|env|(e|f)?grep|head|install|ln|make|mkdir|mv|popd|printf|pushd|rm|rmdir|sed|set|sort|tail|tar|(un)?zip|(un)?rar|touch|umask|unset|read|ls|wc|pwd|which|whereis|uname|find|xargs|tee|tr|du|df|date|su(do)?|curl|wget|ping|ssh|rsync|scp|alias|type|clear|getopts|trap|bg|fg|jobs|calc|bc|seq|expr|factor)\>"
#color green "\<(su(do)?)\>"
color normal "[.-]tar\>"
# Fix accidental matches inside file paths
color normal "(/[[:alnum:]]+|[[:alnum:]]+[/=.])"

# Numbers
color cyan "\<[0-9]+\.?[0-9]*[e|E][+-]?[0-9]+[f|F]?\>"
color cyan "\<[1-6]?[0-9]#[0-9a-zA-Z@_]+\>"
color cyan "\<[0-9]+(\.[0-9]+)?\>"
color cyan "\<0[x][0-9a-f]+\>"
color cyan "\<0[0-7]+\>"
color cyan "\<0[b][0-1]+\>"
# Fix accidental numbers inside file paths
#color normal "\<[0-9]+-[A-Za-z_][[:alnum:]_-]*\>"

# Operators, punctuation
color green "[][{}():;,|`$<>!=\\&]"
color green "([+-/*%]|>>|<<|&|#|\^|\|)="
color green "=(~)"
#color yellow "[)(]"
#color yellow "[][{}()$`'\"]"
color green "-(eq|ne|gt|lt|ge|le|ef|ot|nt)\>"

# Strings.
color brightblue ""([^"\]|\\.)*"|'([^'\]|\\.)*'"

# Basic variable names (no braces).
#color brightyellow "\$([-@*#?$!0-9]|[[:alpha:]_][[:alnum:]_]*)"
# More complicated variable names; handles braces and replacements and arrays.
#color brightyellow "\$\{[#!]?([-@*#?$!]|[0-9]+|[[:alpha:]_][[:alnum:]_]*)(\[([[:blank:]]*[[:alnum:]_]+[[:blank:]]*|@)\])?(([#%/]|:?[-=?+])[^}]*\}|\[|\})"
# Fix $ inside strings
color brightmagenta "\<$_\>"
color brightmagenta "[$@]"
color blue "[}{]"
color green "[#]"
#color cyan "[)(]"

# Trailing whitespace.
color ,green "[[:space:]]+$"

# Comments.
color magenta "(^|[[:blank:]])#.*"

# Reminders
color brightwhite,magenta "\<(FIXME|fixme|TODO|todo)\>"

# Git conflict markers
color black,red "^[[:blank:]]*(<<<<<<<|=======|>>>>>>>).*$"
