# =================================================
#  Syntax highlighting for SFZ virtual instruments
# =================================================

## Developed by Mikhail Shprygov
## Profile: codeberg.org/mikeshp
## Contact: mike.shp@hotmail.com

syntax sfz "\.sfz$"
header "^(<control>|<global>|<group>|<region>)"
comment "//"

# =================================================
#  Base Elements and Groups
# =================================================
## Headers
icolor magenta "<[a-z]+>"
icolor brightred "\<(global)\>"
icolor yellow "\<(control)\>"
icolor yellow "\<(curve)\>"
icolor brightmagenta "\<(group)\>"
icolor red "\<(region)\>"
## Parameters (left from the equals sign)
icolor green  "[a-z0-9_-]+="
## Numeric values (right from the equals sign)
icolor normal "=[a-z0-9_/\.-]+"
## The equals sign
icolor blue "="

# =================================================
#  Other elements and fallback highlighting
# =================================================
## String values and file paths
icolor brightblue ""([^"\\]|\\.)*""
## File path includes
icolor brightgreen "^[[:blank:]]*#[[:blank:]]*((include(_next)?|line)\>)"
## Fix hash on file path includes
icolor normal "^[[:blank:]]*#"

# =================================================
#  Comments, Notes, Reminders
# =================================================
## Trailing whitespace
icolor ,green "[[:space:]]+$"
## Comments
icolor cyan "//[^"]*$|(^|[[:blank:]])//.*"
icolor cyan start="/\*" end="\*/"
## Reminders
icolor black,cyan "\<(fixme|todo)\>"
## Git conflict markers
icolor black,red "^[[:blank:]]*(<<<<<<<|=======|>>>>>>>).*$"
