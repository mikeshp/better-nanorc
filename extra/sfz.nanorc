# =================================================
#  Syntax highlighting for SFZ virtual instruments
# =================================================

## Developed by Mikhail Shprygov
## Profile: codeberg.org/mikeshp
## Contact: mike.shp@hotmail.com

syntax sfz "\.sfz$"
header "^(<control>|<global>|<group>|<region>)"
comment "//"

# =================================================
#  Base elements and groups
# =================================================
## Headers (Anything inside the <> brackets)
icolor magenta "<[a-z]+>"
## Opcodes (Parameters left from the equals sign)
icolor green "[a-z0-9_-]+="
## Sample values (File path right from the equals sign)
icolor normal "=[a-z0-9_*/\.-]+"
## Numeric values (Numbers right from the equals sign)
icolor brightblue "(=|[[:space:]])([-])?[0-9]+(.[0-9]+)?"
## The equals sign
icolor brightblack "="

# =================================================
#  Other elements and fallback highlighting
# =================================================
## Variables (Predefined macros)
icolor cyan "\$[a-z_]+"
## String values and file paths
icolor brightblue ""([^"\\]|\\.)*""
## Include and Define directives
icolor brightgreen "^[[:blank:]]*#[[:blank:]]*((include|define)\>)"
## Fix hash on the directives
icolor normal "^[[:blank:]]*#"

# =================================================
#  Comments, Notes, Reminders
# =================================================
## Trailing whitespace
icolor ,green "[[:space:]]+$"
## Comments
icolor red "//[^"]*$|(^|[[:blank:]])//.*"
icolor red start="/\*" end="\*/"
## Reminders
icolor black,red "\<(fixme|todo)\>"
## Git conflict markers
icolor black,yellow "^[[:blank:]]*(<<<<<<<|=======|>>>>>>>).*$"
