## Syntax highlighting for Free Pascal

## This file was heavily modified by Mikhail Shprygov
## I write in Free Pascal for FPC on Linux only
## and I have no idea how this may behave on other dialect/platform
## For any questions and suggestions find me on github.com/mshprygov

#syntax "pascal" "\.pas$" "\.pp$"
syntax "pascal" "\.(pas|pp|lpr)$"
comment "//"

# Numbers
color cyan "\<[0-9]+(\.[0-9]+)?\>"

# Reserved Keywords Turbo Pascal
icolor brightblue "\<(and|array|asm|begin|break|case|const|constructor|continue|destructor|div|do|downto|else|end|false|file|for|function|goto|if|implementation|in|inline|interface|label|mod|nil|not|object|of|on|operator|or|packed|procedure|program|record|repeat|set|shl|shr|then|to|true|type|unit|until|uses|var|while|with|xor)\>"

# Reserved Keywords Object Pascal
icolor brightblue "\<(as|class|constref|dispose|except|exit|exports|finalization|finally|inherited|initialization|is|library|new|on|out|property|raise|self|resourcestring|threadvar|try)\>"

# Modifiers
icolor magenta "\<(absolute|abstract|alias|assembler|cdecl|cppdecl|default|export|external|forward|generic|index|local|nostackframe|oldfpccall|override|pascal|private|protected|public|published|register|reintroduce|safecall|softfloat|specialize|stdcall|virtual|far|near)\>"

# DataTypes
icolor green "\<((u|p)?int(8|16|32|64)|real|currency|extended|single|double|(p)?(char|byte|cardinal|integer|string)|boolean|(long|p|pq|d|q)?word|(p)?longint|textfile|file|text|pointer)\>"
# More Int DataTypes
icolor green "\<((native|ptr|size)+u?int|(small|short|long)+int)\>"
# More String DataTypes
icolor green "\<p?(ansi|short|unicode|wide)?+(string|char)\>"
# Structured DataTypes
icolor brightblue "\<(record|class|object|set|array|of|variant|interface|enum)\>"
icolor brightblue "\<(set|array|of|variant|enum)\>"
# BaseUnix Types
## File amd I/O containers
icolor green "\<(TStat|stat|TFlock|flock|TPollFD|pollfd|TUtimbuf|utimbuf|TTimeVal|timeval|TTimeSpec|timespec)\>"
## Signals and System state
icolor green "\<(TSigAction|sigaction|TSigSet|sigset_t|TTIOCPGRP|TFDSet|fd_set|T_TMS|tms|TUname|utsname)\>"
## Pointers and Kernel alaises
icolor green "\<((p)+(Stat|Flock|Utimbuf|TimeVal|TimeSpec|SigAction|SigSet|FDSet|_TMS|Uname))\>"
## Integers and Architecture primitives
icolor green "\<(TCint|cint|TCsShort|csshort|TCuChar|cuchar|TCuInt|cuint|TCuInt16|cuint16|TCuInt32|cuint32|pcslonglong|pcsshort|pcuchar|pcuint|pcuint16|pcuint32|TDev|dev_t|TGid|gid_t|TIno|ino_t|TMode|mode_t|TNlink|nlink_t|TOff|off_t|TPid|pid_t|TSize|size_t|TSsize|ssize_t|TUid|uid_t|TClock|clock_t|TTime|time_t)\>"

# Other
icolor yellow "\<((up|lower)case|assignfile|Close|Param(Str|Count)|(Set)?Length|Inc|Dec|GetUserDir|Assign|Rewrite|CompareStr|Delete|CompareText|Pos|(Left|Right)Str|Copy|FileExists|Reset|Read(ln)?|Write(ln)?|Eof|Eol|Nil)\>"

# Crt commands
icolor yellow "\<(assigncrt|clr(scr|eol)|del(ay|line)|(high|low|norm)video|(no)?sound|insline|readkey|keypressed|text(color|background)|gotoxy|where(x|y)|window)\>"
# Crt variables
icolor green "\<(screen(height|width)|check(break|eof|snow)|directvideo|textattr|wind(max|min|maxx|maxy|minx|miny))\>"

# BaseUnix Routines
## File and firectory management
icolor yellow "\<((fp)+(Access|Chdir|Chmod|Chown|Close|FChmod|FChown|FStat|Ftruncate|Getcwd|LSeek|LStat|Mkdir|Open|Read|ReadLink|Rename|Rmdir|Stat|Symlink|Truncate|Unlink|Write|WriteV|UTime))\>"
## Process and system management
icolor yellow "\<(CreateShellArgV|FreeShellArgV|(fp)+(Alarm|Execv|Execve|Execvp|Exit|Fork|Getegid|Getenv|Geteuid|Getgid|Getgroups|Getpgrp|Getpid|Getppid|Getpriority|Getuid|Kill|Pause|Setgid|Setpgid|Setpriority|Setsid|Setuid|Sleep|Times|Umask|Uname|Wait|WaitPid))\>"
## Signals and memory allocation
icolor yellow "\<((fp)+(Sigaction|Signal|Sigpending|Sigprocmask|Sigsuspend|mmap|munmap|geterrno|time))\>"
## Evaluation macros (?)
icolor yellow "\<((fp)+(S_ISBLK|S_ISCHR|S_ISDIR|S_ISFIFO|S_ISLNK|S_ISREG|S_ISSOCK)|(w)+)exitStatus|ifexited|ifsignaled|ifstopped|stopsig|termsig))\>"

# SysUtils
icolor yellow "\<(StringOfChar)\>"

# Math functions
icolor yellow "\<(floor|ceil|abs|arctan|sin|cos|sincos|dec|inc|exp|frac|hi|int|ln|lo|odd|pi|round|sqr|sqrt|swap|trunc|ord|succ|pred|low|high|chr)\>"
icolor yellow "\<(random(ize)?|randseed)\>"

# File Handling
icolor yellow "\<(eol|eoln|eof|seekeoln|seekeof|assign|append|close|closefile|reset|rewrite|seek|blockread|blockwrite|chdir|concat|copy|seek|filepos|eof|rename|flush|erase)\>"

# Memory Operations
icolor yellow "\<(addr|assigned|dispose|fillchar|freemem|getmem|move|new|reallocmem)\>"
icolor green "\<(assigned|sizeof|(set)?length)\>"

# Casting and Parsing routines
icolor yellow "\<(insert|delete|ord|chr|str|strtoint(def)?|strtofloat|pos|val|(int|float)+tostr)\>"

# Special Constants
icolor cyan "\<(true|false)\>"
icolor cyan "\<(nil|nan|pi|infinity|unassigned)\>"
# Special predefined variables
icolor green "\<(stdin|stdout|stderr|input|output)\>"
icolor green "\<(LineEnding|(Directory|Path)Separator|Param(Str|Count))\>"
# Special reserved words
icolor magenta "\<(Result|self)\>"
icolor green "\<(self)\>"
# Special reserved methods
icolor yellow "\<(create|destroy|clear|free)\>"
# BaseUnix macros and constants
## Standard streams
icolor green "\<((STDIN_|STDOUT_|STDERR_)FILENO)\>"
## File open modes and flags
icolor green "\<(O_(RDONLY|WRONLY|RDWR|ACCMODE|CREAT|EXCL|NOCTTY|TRUNC|APPEND|NONBLOCK|NDELAY|SYNC|FSYNC|ASYNC|DIRECTORY|NOFOLLOW|CLOEXEC|LARGEFILE))\>"
## File status attributes
icolor green "\<(S_(IRWXU|IRUSR|IWUSR|IXUSR|IRWXG|IRGRP|IWGRP|IXGRP|IRWXO|IROTH|IWOTH|IXOTH|ISUID|ISGID|ISVTX))\>"
## File system node qualifiers
icolor green "\<(STAT_IF(MT|SOCK|LNK|REG|BLK|DIR|CHR|IFO))\>"
## Access operations and seekers
icolor green "\<(F_OK|X_OK|W_OK|R_OK|SEEK_SET|SEEK_CUR|SEEK_END)\>"
## Process priority flags
icolor green "\<(PRIO_PROCESS|PRIO_PGRP|PRIO_USER)\>"
## Memory map protocol targets
icolor green "\<(PROT_READ|PROT_WRITE|PROT_EXEC|PROT_NONE|MAP_SHARED|MAP_PRIVATE|MAP_FIXED|MAP_ANONYMOUS|MAP_ANON)\>"
## Standard POSIX system signals
icolor green "\<(SIG(HUP|INT|QUIT|ILL|TRAP|ABRT|IOT|BUS|FPE|KILL|USR1|SEGV|USR2|PIPE|ALRM|TERM|STKFLT|CHLD|CONT|STOP|TSTP|TTIN|TTOU|URG|XCPU|XFSZ|VTALRM|PROF|WINCH|IO|POLL|PWR|SYS|_BLOCK|_UNBLOCK|_SETMASK|_DFL|_ERR|_IGN))\>"
## Wait and exit status parameters
icolor green "\<(WNOHANG|WUNTRACED)\>"

# Flow control
icolor magenta "\<(break|continue|exit|label|goto|halt)\>"

# Block flow control
icolor blue "\<(interface|implementation|finalization|initialization)\>"

# Operators
color brightyellow "[][}{)(,.;:/=+*!?`^@&~><-]+"
# Logic Operators
icolor brightblue "\<(and|or|not|xor|in)\>"
# Math and Bitwise
icolor brightyellow "\<(mod|div|shl|shr)\>"
# Escape, Pointers and Character Expression
color green "[&@#$^]"
# For Loops
icolor brightblue "\<(to|downto)\>"
# Brackets
color brightgreen "[)(]"
# Squares
color green "[][]"

# Text Strings
color brightmagenta "'([^']|'')*'"

# Trailing whitespace
color ,green "[[:space:]]+$"

# Comments
color red "//.*$"
color red start="\{" end="\}"
color red start="\(\*" end="\*\)"

# Compiler directives
color magenta start="\{\$" end="\}"

# Reminders
icolor black,green "\<(fixme|todo|xxx)\>"

# Git conflict markers
color black,red "^[[:blank:]]*(<<<<<<<|=======|>>>>>>>).*$"
