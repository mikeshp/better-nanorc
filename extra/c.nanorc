## Syntax highlighting for C and C++ files.

## This file was modified by Mikhail Shprygov
## Since I only write in C for GCC on Linux,
## I am not sure about its behaviour with C++
## For contact find me on github.com/mshprygov

syntax c "\.([ch](pp|xx)?|C|cc|c\+\+|cu|H|hh|ii?)$"
header "-\*-.*\<C(\+\+)?((;|[[:blank:]]).*)?-\*-"
magic "^(C|C\+\+) (source|program)"
comment "//"

# =======================================
#  Base Keywords and Types
# =======================================
## Base C keywords
color green "\<(auto|break|case|bool|char|const|continue|default|do|double|else|enum|extern|float|for|goto|if|inline|int|long|register|return|restrict|short|signed|sizeof|static|struct|switch|typedef|union|unsigned|void|volatile|while|size_t)\>"
## More types
color green "\<(_(Alignas|Alignof|Atomic|Bool|Complex|Generic|Imaginary|Noreturn|Static_assert|Thread_local))\>"
color green "\<(class|explicit|friend|mutable|namespace|override|private|protected|public|register|template|this|typename|using|virtual|volatile)\>"
## C23 adds
color green "\<(bool|alignas|alignof|constexpr|false|nullptr|static_assert|thread_local|true|typeof|typeof_unqual|_BitInt|_Decimal(32|64|128))\>"
## Stdint.h
color green "\<([[:lower:]][[:lower:]_]*|(u_?)?int(8|16|32|64))_t\>"
## Math.h types
color green "\<(float_t|double_t|u?intptr_t|u?intmax_t)\>"
## Time.h types
color green "\<(time_t|clock_t|timespec|timeval)\>"
## User defined types
color green "\<(struct|union|enum|typedef)\>"
## Storage types
color green "\<(auto|extern|static|register)\>"

# =======================================
#  Flow Control
# =======================================
## Conditionals and loop control
color brightyellow "\<(if|else|for|while|do|switch|case|default)\>"
color brightyellow "\<(try|throw|catch|operator|new|delete)\>"
color magenta "\<(break|continue|goto|return|exit|abort)\>"
## Labels
color brightyellow "^[[:blank:]]*[A-Z_a-z][0-9A-Z_a-z]*:[[:blank:]]*$"
color brightyellow ":[[:blank:]]*$"

# =======================================
#  Operators, Punctuation, Brackets
# =======================================
color green "[-+,;:/=*!?%&|^~><]+"
color green "[&|^~><]"
color green "\<(and|or|xor|not)\>"
color green "\<(sizeof|decltype)\>"
color brightgreen "[)(]"
color brightgreen "[;,]"
color normal "[}{]"
color green  "[][]"
color normal "[.]"

# =======================================
#  Macros, Constants and Numbers
# =======================================
## Constants and macros
color normal "\<[A-Z_][0-9A-Z_]*\>"
## Special constants and system tokens
color green "\<(FILE|DIR)\>"
color cyan "\<(true|false)\>"
color cyan "\<(this)\>"
color brightred "\<(NULL|EOF)\>"
color green "\<(stdin|stdout|stderr)\>"
## Numbers
icolor cyan "\<[0-9]+((\.[0-9]+)|(llu|ull|ul|lu|ll|l|u))?\>"
icolor cyan "\<[0-9]+\.?[0-9]*[e][+-]?[0-9]+[f]?\>"
icolor cyan "\<0[x][0-9a-f]+(llu|ull|ul|lu|ll|l|u)?\>"
icolor cyan "\<0[0-7]+(llu|ull|ul|lu|ll|l|u)?\>"
icolor cyan "\<0[b][0-1]+(llu|ull|ul|lu|ll|l|u)?\>"

# =======================================
#  Built-in Functions
# =======================================
## Math.h functions
#color yellow "\<(a?cosh?|a?sinh?|a?tanh?)\>"
#color yellow "\<(pow|sqrt|cbrt|exp|log)\>"
#color yellow "\<(ceil|floor|round|trunc)\>"
#color yellow "\<(f?(max|min|abs|dim))\>"
## Stdio.h functions
#color yellow "\<((f|s)?printf|(f|s)?scanf|snprintf)\>"
#color yellow "\<(f?getc|f?gets|f?putc|f?puts|getchar|putchar|ungetc)\>"
## Stdlib.h functions
#color yellow "\<(feof|ferror|clearerr|perror|setbuf|setvbuf)\>"
#color yellow "\<(malloc|realloc|free|calloc|new|delete)\>"
## String.h functions
#color yellow "\<(strn?cpy|strn?cat|strn?cmp|strn?dup|strlen|strr?chr|strstr|strtok|strc?spn|pbrk|strcoll|strxfrm)\>"
#color yellow "\<(memcpy|memmove|memset|memcmp|memchr)\>"
## Ctype.h functions
#color yellow "\<(tolower|toupper)\>"
#color yellow "\<(is(alnum|alpha|blank|cntrl|digit|graph|lower|print|punct|space|upper|xdigit))\>"
## Time.h functions
#color yellow "\<(s?rand|time|clock|timespec_get|difftime)\>"
## File handling
#color yellow "\<(fopen|fclose|freopen|fflush|setbuf|setvbuf|fread|fwrite|fgetpos|ftell|fseek|fsetpos|rewind|remove|rename|tmpfile|tmpnam)\>"
## GCC builtins
color yellow "__attribute__[[:blank:]]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"
## Deprecated
#color yellow,white "\<(gets)\>"

# =======================================
#  Strings and Literals
# =======================================
## Single-quoted stuff (characters, backslash escapes, hex and octal byte codes)
color brightmagenta "'([^'\]|\\(["'\abfnrtv]|x[[:xdigit:]]{1,2}|[0-3]?[0-7]{1,2}))'"
## Double-quoted strings and names of included files
color brightred "\"([^"]|\\")*"|#[[:blank:]]*include[[:blank:]]*<[^>]+>"
## Format specifiers
#color red "%-?[0-9]*(\.[0-9]+)?(z|ll|l|h)?(d|i|u|o|x|X|f|F|e|E|g|G|a|A|c|s|p|n)"
## Highlight escape inside strings
color red "\\"
## Fix \0 and \n inside single quotes
color brightmagenta "'(\\0|\\n)'"
## Preprocessor directives
color cyan start="^[[:blank:]]*#[[:blank:]]*(if(n?def)?|elif|warning|error|pragma)\>" end="(\`|[^\])$"
color cyan "^[[:blank:]]*#[[:blank:]]*((define|else|endif|include(_next)?|line|undef)\>|$)"
## Fix hash on preprocessor lines
color red "^[[:blank:]]*#"

# =======================================
#  Comments, Notes, Reminders
# =======================================
## Trailing whitespace
color ,green "[[:space:]]+$"
## Comments
color brightblue "//[^"]*$|(^|[[:blank:]])//.*"
color brightblue start="/\*" end="\*/"
## Reminders
color brightwhite,blue "\<(FIXME|TODO|XXX)\>"
## Git conflict markers
color black,red "^[[:blank:]]*(<<<<<<<|=======|>>>>>>>).*$"
